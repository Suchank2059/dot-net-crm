
# MySQL configuration
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=crm
MYSQL_USER=crm_user
MYSQL_PASSWORD=change_me_database_password
MYSQL_PORT=3307

# phpMyAdmin
PHPMYADMIN_PORT=8082

# .NET backend database connection
# Use "mysql" as the hostname because the backend runs inside Docker.
ConnectionStrings__DefaultConnection=Server=mysql;Port=3306;Database=crm;User=crm_user;Password=change_me_database_password;
